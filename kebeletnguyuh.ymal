```yaml
name: Build Kernel Samsung GTA9

on:
  workflow_dispatch:

jobs:
  build:
    name: Build Kernel by ${{ github.actor }}
    runs-on: ubuntu-22.04

    env:
      ARCH: arm64
      SUBARCH: arm64

      WORKSPACE: ${{ github.workspace }}/kernel_workspace
      KERNEL_DIR: ${{ github.workspace }}/kernel_workspace/gta9
      OUT_DIR: ${{ github.workspace }}/kernel_workspace/gta9/out

      KERNEL_REPO: https://github.com/prabhatkrmishra/kernel_samsung_gta9.git

      # PENTING: branch yang benar adalah 15.0
      KERNEL_BRANCH: "15.0"

      # PENTING: defconfig yang benar di branch 15.0
      DEFCONFIG: "gta9_defconfig"

      CLANG_VERSION: r416183b

      SUSFS_BRANCH: gki-android13-5.10

      CCACHE_COMPILERCHECK: "%compiler% -dumpmachine; %compiler% -dumpversion"
      CCACHE_NOHASHDIR: "true"
      CCACHE_HARDLINK: "true"

    steps:

      # ==========================================================
      # 1. CHECKOUT
      # ==========================================================
      - name: Checkout Repository
        uses: actions/checkout@v4
        with:
          clean: false
          fetch-depth: 1

      # ==========================================================
      # 2. SWAP
      # ==========================================================
      - name: Set swap space
        uses: pierotofy/set-swap-space@master
        with:
          swap-size-gb: 12

      # ==========================================================
      # 3. HOST DEPENDENCIES
      # ==========================================================
      - name: Setup build kernel environment
        shell: bash
        run: |
          set -euxo pipefail

          echo "BUILD_TIME=$(TZ=Asia/Jakarta date '+%Y%m%d%H%M')" >> "$GITHUB_ENV"

          sudo apt-get update

          sudo apt-get install -y \
            git \
            curl \
            wget \
            ca-certificates \
            ccache \
            bc \
            bison \
            flex \
            gawk \
            gcc \
            g++ \
            make \
            build-essential \
            libssl-dev \
            libelf-dev \
            libdw-dev \
            libncurses5-dev \
            libncurses-dev \
            libc6-dev-i386 \
            lib32z1-dev \
            lib32ncurses5-dev \
            libxml2-utils \
            xsltproc \
            unzip \
            zip \
            rsync \
            lz4 \
            lzop \
            zlib1g-dev \
            device-tree-compiler \
            python3 \
            perl \
            cpio \
            dwarves \
            pkg-config \
            gcc-aarch64-linux-gnu \
            gcc-arm-linux-gnueabi

          mkdir -p "$WORKSPACE"
          mkdir -p "$WORKSPACE/downloads"
          mkdir -p "$GITHUB_WORKSPACE/output"

          echo "===== HOST ====="
          uname -a

          echo
          echo "===== AARCH64 GCC ====="
          aarch64-linux-gnu-gcc --version | head -n 1

      # ==========================================================
      # 4. CCACHE
      # ==========================================================
      - name: Restore ccache
        uses: actions/cache@v4
        with:
          path: ~/.cache/ccache
          key: gta9-ccache-${{ runner.os }}-${{ env.KERNEL_BRANCH }}-${{ env.CLANG_VERSION }}-${{ github.sha }}
          restore-keys: |
            gta9-ccache-${{ runner.os }}-${{ env.KERNEL_BRANCH }}-${{ env.CLANG_VERSION }}-
            gta9-ccache-${{ runner.os }}-

      - name: Configure ccache
        shell: bash
        run: |
          set -euxo pipefail

          mkdir -p ~/.cache/ccache

          ccache --set-config=max_size=5G
          ccache --set-config=compression=true

          echo "CCACHE_DIR=$HOME/.cache/ccache" >> "$GITHUB_ENV"

          ccache --show-config
          ccache --show-stats || true

      # ==========================================================
      # 5. CLONE KERNEL SOURCE
      # ==========================================================
      - name: Clone Source & Verify GTA9 Tree
        shell: bash
        run: |
          set -euxo pipefail

          rm -rf "$KERNEL_DIR"

          echo "=================================================="
          echo "GTA9 KERNEL SOURCE"
          echo "=================================================="

          echo "Repository : $KERNEL_REPO"
          echo "Branch     : $KERNEL_BRANCH"
          echo "Defconfig  : $DEFCONFIG"
          echo

          git clone \
            --depth=1 \
            --branch "$KERNEL_BRANCH" \
            "$KERNEL_REPO" \
            "$KERNEL_DIR"

          cd "$KERNEL_DIR"

          echo
          echo "===== ACTUAL BRANCH ====="
          git branch --show-current

          echo
          echo "===== COMMIT ====="
          git rev-parse HEAD

          echo
          echo "===== KERNEL VERSION ====="
          make kernelversion || true

          echo
          echo "===== GTA9 CONFIG FILES ====="
          find arch/arm64/configs \
            -maxdepth 1 \
            -type f \
            \( \
              -name 'gta9*' \
              -o -name '*8781*' \
            \) \
            -printf '%f\n' \
            | sort

          echo
          echo "===== VERIFY DEFCONFIG ====="

          test -f "arch/arm64/configs/$DEFCONFIG"

          ls -lh "arch/arm64/configs/$DEFCONFIG"

          echo
          echo "DEFCONFIG OK: $DEFCONFIG"

          echo
          echo "===== SUBMODULES ====="

          git submodule sync --recursive || true
          git submodule update --init --recursive --depth=1 || true

      # ==========================================================
      # 6. CLANG CACHE
      # ==========================================================
      - name: Cache Android Clang
        uses: actions/cache@v4
        with:
          path: ${{ env.WORKSPACE }}/prebuilts/clang/host/linux-x86/clang-${{ env.CLANG_VERSION }}
          key: gta9-clang-${{ env.CLANG_VERSION }}

      # ==========================================================
      # 7. SETUP CLANG
      # ==========================================================
      - name: Setup Android Clang
        shell: bash
        run: |
          set -euxo pipefail

          CLANG_ROOT="$WORKSPACE/prebuilts/clang/host/linux-x86/clang-$CLANG_VERSION"

          if [ ! -x "$CLANG_ROOT/bin/clang" ]; then
            echo "Clang cache miss."

            mkdir -p "$WORKSPACE/prebuilts/clang/host/linux-x86"
            mkdir -p "$WORKSPACE/downloads"

            cd "$WORKSPACE/downloads"

            rm -f "clang-${CLANG_VERSION}.tar.gz"

            wget -q --show-progress \
              "https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/refs/heads/android12-release/clang-${CLANG_VERSION}.tar.gz" \
              -O "clang-${CLANG_VERSION}.tar.gz"

            mkdir -p "$CLANG_ROOT"

            tar \
              -xzf "clang-${CLANG_VERSION}.tar.gz" \
              -C "$CLANG_ROOT"
          fi

          test -x "$CLANG_ROOT/bin/clang"

          echo "CLANG_PREBUILT_BIN=$CLANG_ROOT/bin" >> "$GITHUB_ENV"
          echo "$CLANG_ROOT/bin" >> "$GITHUB_PATH"

          echo
          echo "===== CLANG ====="
          "$CLANG_ROOT/bin/clang" --version

      # ==========================================================
      # 8. SETUP RESUKISU
      # ==========================================================
      - name: Setup ReSukiSU
        shell: bash
        run: |
          set -euxo pipefail

          cd "$KERNEL_DIR"

          echo "=================================================="
          echo "SETTING UP RESUKISU"
          echo "=================================================="

          curl -LSs \
            "https://raw.githubusercontent.com/ReSukiSU/ReSukiSU/main/kernel/setup.sh" \
            -o /tmp/resukisu_setup.sh

          chmod +x /tmp/resukisu_setup.sh

          bash /tmp/resukisu_setup.sh

          echo
          echo "===== RESUKISU CHECK ====="

          test -d KernelSU

          find KernelSU \
            -maxdepth 2 \
            -type f \
            | head -n 50

      # ==========================================================
      # 9. SETUP SUSFS
      # ==========================================================
      - name: Setup SUSFS
        id: susfs
        shell: bash
        run: |
          set -u

          cd "$KERNEL_DIR"

          SUSFS_DIR="$WORKSPACE/susfs_src"

          echo "=================================================="
          echo "SETTING UP SUSFS"
          echo "=================================================="

          rm -rf "$SUSFS_DIR"

          if ! git clone \
            --depth=1 \
            --branch "$SUSFS_BRANCH" \
            https://gitlab.com/simonpunk/susfs4ksu.git \
            "$SUSFS_DIR"; then

            echo "SUSFS clone gagal."
            echo "Melanjutkan build tanpa SUSFS."
            echo "SUSFS_ENABLED=false" >> "$GITHUB_ENV"
            exit 0
          fi

          echo "SUSFS repository berhasil di-clone."

          KSU_PATCH="$SUSFS_DIR/kernel_patches/KernelSU/10_enable_susfs_for_ksu.patch"

          KERNEL_PATCH="$SUSFS_DIR/kernel_patches/50_add_susfs_in_${SUSFS_BRANCH}.patch"

          echo
          echo "KSU patch:"
          echo "$KSU_PATCH"

          echo
          echo "Kernel patch:"
          echo "$KERNEL_PATCH"

          if [ ! -f "$KSU_PATCH" ]; then
            echo "KSU SUSFS patch tidak ditemukan."
            echo "SUSFS_ENABLED=false" >> "$GITHUB_ENV"
            exit 0
          fi

          if [ ! -f "$KERNEL_PATCH" ]; then
            echo "Kernel SUSFS patch tidak ditemukan."
            echo "SUSFS_ENABLED=false" >> "$GITHUB_ENV"
            exit 0
          fi

          echo
          echo "===== APPLY KSU SUSFS PATCH ====="

          cd "$KERNEL_DIR/KernelSU"

          if patch -p1 --forward < "$KSU_PATCH"; then
            echo "KSU SUSFS patch OK."
          else
            echo "KSU SUSFS patch gagal."
            echo "SUSFS_ENABLED=false" >> "$GITHUB_ENV"
            exit 0
          fi

          echo
          echo "===== APPLY KERNEL SUSFS PATCH ====="

          cd "$KERNEL_DIR"

          if patch -p1 --forward < "$KERNEL_PATCH"; then
            echo "Kernel SUSFS patch OK."
          else
            echo "Kernel SUSFS patch gagal."
            echo "SUSFS_ENABLED=false" >> "$GITHUB_ENV"
            exit 0
          fi

          echo "SUSFS_ENABLED=true" >> "$GITHUB_ENV"

          echo
          echo "SUSFS PATCH COMPLETE"

      # ==========================================================
      # 10. CONFIGURE DEFCONFIG
      # ==========================================================
      - name: Configure GTA9 Kernel
        shell: bash
        run: |
          set -euxo pipefail

          cd "$KERNEL_DIR"

          DEFCONFIG_PATH="arch/arm64/configs/$DEFCONFIG"

          test -f "$DEFCONFIG_PATH"

          cp "$DEFCONFIG_PATH" "${DEFCONFIG_PATH}.backup"

          echo "=================================================="
          echo "MODIFY GTA9 DEFCONFIG"
          echo "=================================================="

          set_cfg() {
            local key="$1"
            local value="$2"

            sed -i \
              -E \
              "/^${key}=.*$/d;/^# ${key} is not set$/d" \
              "$DEFCONFIG_PATH"

            echo "${key}=${value}" >> "$DEFCONFIG_PATH"
          }

          unset_cfg() {
            local key="$1"

            sed -i \
              -E \
              "/^${key}=.*$/d;/^# ${key} is not set$/d" \
              "$DEFCONFIG_PATH"

            echo "# ${key} is not set" >> "$DEFCONFIG_PATH"
          }

          # Samsung security restrictions
          unset_cfg CONFIG_SEC_RESTRICT_FORK
          unset_cfg CONFIG_SEC_RESTRICT_ROOTMOD
          unset_cfg CONFIG_SECURITY_DEFEX
          unset_cfg CONFIG_TIMA
          unset_cfg CONFIG_TIMA_LKMAUTH
          unset_cfg CONFIG_SEC_KAP
          unset_cfg CONFIG_INTEGRITY_SAMSUNG

          # SELinux development
          set_cfg CONFIG_SECURITY_SELINUX_DEVELOP y

          # Kernel features
          set_cfg CONFIG_KPROBES y
          set_cfg CONFIG_KPROBE_EVENTS y
          set_cfg CONFIG_OVERLAY_FS y

          # ReSukiSU
          set_cfg CONFIG_KSU y

          if grep -RqsE '^config KSU_MANUAL_HOOK' KernelSU/kernel; then
            set_cfg CONFIG_KSU_MANUAL_HOOK y
          fi

          # SUSFS
          if [ "${SUSFS_ENABLED:-false}" = "true" ]; then
            set_cfg CONFIG_KSU_SUSFS y
          fi

          echo
          echo "===== DEFCONFIG CHECK ====="

          grep -E \
            'CONFIG_(KSU|KSU_MANUAL_HOOK|KSU_SUSFS|SEC_RESTRICT_FORK|SEC_RESTRICT_ROOTMOD|SECURITY_DEFEX|TIMA|TIMA_LKMAUTH|SEC_KAP|INTEGRITY_SAMSUNG|SECURITY_SELINUX_DEVELOP|KPROBES|KPROBE_EVENTS|OVERLAY_FS)' \
            "$DEFCONFIG_PATH" \
            || true

      # ==========================================================
      # 11. GENERATE FINAL .CONFIG
      # ==========================================================
      - name: Generate Final Config
        shell: bash
        run: |
          set -euxo pipefail

          cd "$KERNEL_DIR"

          rm -rf "$OUT_DIR"
          mkdir -p "$OUT_DIR"

          echo "=================================================="
          echo "RUN $DEFCONFIG"
          echo "=================================================="

          make \
            O="$OUT_DIR" \
            ARCH="$ARCH" \
            "$DEFCONFIG"

          echo
          echo "===== OLDDEFCONFIG ====="

          make \
            O="$OUT_DIR" \
            ARCH="$ARCH" \
            olddefconfig

          test -f "$OUT_DIR/.config"

          echo
          echo "===== FINAL CONFIG ====="

          grep -E \
            'CONFIG_(KSU|KSU_MANUAL_HOOK|KSU_SUSFS|SEC_RESTRICT_FORK|SEC_RESTRICT_ROOTMOD|SECURITY_DEFEX|TIMA|TIMA_LKMAUTH|SEC_KAP|INTEGRITY_SAMSUNG|SECURITY_SELINUX_DEVELOP|KPROBES|KPROBE_EVENTS|OVERLAY_FS)' \
            "$OUT_DIR/.config" \
            || true

          if ! grep -q '^CONFIG_KSU=y$' "$OUT_DIR/.config"; then
            echo "ERROR: CONFIG_KSU=y tidak aktif."
            exit 1
          fi

          cp \
            "$OUT_DIR/.config" \
            "$GITHUB_WORKSPACE/output/gta9-final-config"

      # ==========================================================
      # 12. BUILD
      # ==========================================================
      - name: Compile Kernel
        shell: bash
        run: |
          set -euxo pipefail

          cd "$KERNEL_DIR"

          export PATH="$CLANG_PREBUILT_BIN:$PATH"

          export ARCH=arm64
          export SUBARCH=arm64

          export LLVM=1
          export LLVM_IAS=1

          export CROSS_COMPILE=aarch64-linux-gnu-
          export CROSS_COMPILE_COMPAT=arm-linux-gnueabi-

          export CC="ccache clang"
          export HOSTCC="ccache gcc"
          export HOSTCXX="ccache g++"

          echo "=================================================="
          echo "TOOLCHAIN"
          echo "=================================================="

          which clang
          which ld.lld
          which llvm-objcopy

          clang --version

          echo
          echo "=================================================="
          echo "BUILD KERNEL"
          echo "=================================================="

          make \
            -Otarget \
            -j"$(nproc --all)" \
            O="$OUT_DIR" \
            ARCH=arm64 \
            LLVM=1 \
            LLVM_IAS=1 \
            CROSS_COMPILE=aarch64-linux-gnu- \
            CROSS_COMPILE_COMPAT=arm-linux-gnueabi-

          echo
          echo "===== CCACHE STATS ====="
          ccache --show-stats || true

      # ==========================================================
      # 13. VERIFY IMAGE
      # ==========================================================
      - name: Verify Kernel Image
        shell: bash
        run: |
          set -euxo pipefail

          BOOT_DIR="$OUT_DIR/arch/arm64/boot"

          test -d "$BOOT_DIR"

          echo "===== BOOT OUTPUT ====="

          find "$BOOT_DIR" \
            -maxdepth 3 \
            -type f \
            -printf '%p\n' \
            | sort

          IMAGE=""

          for candidate in \
            "$BOOT_DIR/Image.gz" \
            "$BOOT_DIR/Image" \
            "$BOOT_DIR/Image.lz4"
          do
            if [ -f "$candidate" ]; then
              IMAGE="$candidate"
              break
            fi
          done

          if [ -z "$IMAGE" ]; then
            echo "ERROR: Image kernel tidak ditemukan."
            exit 1
          fi

          echo
          echo "FOUND:"
          ls -lh "$IMAGE"

          case "$(basename "$IMAGE")" in
            Image.gz)
              cp "$IMAGE" "$GITHUB_WORKSPACE/output/Image.gz"
              ;;
            Image)
              cp "$IMAGE" "$GITHUB_WORKSPACE/output/Image"
              ;;
            Image.lz4)
              cp "$IMAGE" "$GITHUB_WORKSPACE/output/Image.lz4"
              ;;
          esac

      # ==========================================================
      # 14. COLLECT DTB / DTBO
      # ==========================================================
      - name: Collect DTB and DTBO
        shell: bash
        run: |
          set -euxo pipefail

          mkdir -p "$GITHUB_WORKSPACE/output/dtb"
          mkdir -p "$GITHUB_WORKSPACE/output/dtbo"

          echo "=================================================="
          echo "SEARCH DTB / DTBO"
          echo "=================================================="

          find "$OUT_DIR" \
            -type f \
            \( \
              -name "*.dtb" \
              -o -name "dtb.img" \
              -o -name "*.dtbo" \
              -o -name "dtbo.img" \
            \) \
            -print \
            | sort \
            | tee "$GITHUB_WORKSPACE/output/dtb-list.txt"

          DTB_COUNT=0
          DTBO_COUNT=0

          while IFS= read -r file; do
            case "$file" in
              *.dtbo|*/dtbo.img)
                DTBO_COUNT=$((DTBO_COUNT + 1))

                cp -v \
                  "$file" \
                  "$GITHUB_WORKSPACE/output/dtbo/$(basename "$file")"
                ;;
              *)
                DTB_COUNT=$((DTB_COUNT + 1))

                cp -v \
                  "$file" \
                  "$GITHUB_WORKSPACE/output/dtb/$(basename "$file")"
                ;;
            esac
          done < <(
            find "$OUT_DIR" \
              -type f \
              \( \
                -name "*.dtb" \
                -o -name "dtb.img" \
                -o -name "*.dtbo" \
                -o -name "dtbo.img" \
              \) \
              -print \
              | sort
          )

          echo
          echo "DTB_COUNT=$DTB_COUNT"
          echo "DTBO_COUNT=$DTBO_COUNT"

          echo "DTB_COUNT=$DTB_COUNT" >> "$GITHUB_ENV"
          echo "DTBO_COUNT=$DTBO_COUNT" >> "$GITHUB_ENV"

          if [ "$DTB_COUNT" -eq 0 ]; then
            echo "ERROR: DTB tidak ditemukan."
            exit 1
          fi

      # ==========================================================
      # 15. BUILD INFO
      # ==========================================================
      - name: Generate Build Info
        shell: bash
        run: |
          set -euxo pipefail

          cd "$KERNEL_DIR"

          {
            echo "BUILD_TIME=$BUILD_TIME"
            echo "KERNEL_REPO=$KERNEL_REPO"
            echo "KERNEL_BRANCH=$KERNEL_BRANCH"
            echo "KERNEL_COMMIT=$(git rev-parse HEAD)"
            echo "KERNEL_VERSION=$(make kernelversion 2>/dev/null || true)"
            echo "DEFCONFIG=$DEFCONFIG"
            echo "CLANG_VERSION=$CLANG_VERSION"
            echo "SUSFS_BRANCH=$SUSFS_BRANCH"
            echo "SUSFS_ENABLED=${SUSFS_ENABLED:-false}"
            echo "DTB_COUNT=${DTB_COUNT:-0}"
            echo "DTBO_COUNT=${DTBO_COUNT:-0}"
          } | tee "$GITHUB_WORKSPACE/output/build-info.txt"

      # ==========================================================
      # 16. RAW PACKAGE
      # ==========================================================
      - name: Package Raw Kernel
        shell: bash
        run: |
          set -euxo pipefail

          cd "$GITHUB_WORKSPACE/output"

          rm -f Galaxy-TabA9-ReSukiSU-Raw.zip

          zip -r9 \
            Galaxy-TabA9-ReSukiSU-Raw.zip \
            Image* \
            gta9-final-config \
            build-info.txt \
            dtb-list.txt \
            dtb \
            dtbo

      # ==========================================================
      # 17. ANYKERNEL3
      # ==========================================================
      - name: Prepare AnyKernel3
        shell: bash
        run: |
          set -euxo pipefail

          cd "$GITHUB_WORKSPACE"

          rm -rf AnyKernel3

          git clone \
            --depth=1 \
            https://github.com/osm0sis/AnyKernel3.git \
            AnyKernel3

          test -f AnyKernel3/anykernel.sh

          if [ -f "$GITHUB_WORKSPACE/output/Image.gz" ]; then
            cp "$GITHUB_WORKSPACE/output/Image.gz" AnyKernel3/Image.gz
          elif [ -f "$GITHUB_WORKSPACE/output/Image" ]; then
            cp "$GITHUB_WORKSPACE/output/Image" AnyKernel3/Image
          elif [ -f "$GITHUB_WORKSPACE/output/Image.lz4" ]; then
            cp "$GITHUB_WORKSPACE/output/Image.lz4" AnyKernel3/Image.lz4
          else
            echo "ERROR: Image kernel tidak tersedia."
            exit 1
          fi

          mkdir -p AnyKernel3/dtb

          cp -av \
            "$GITHUB_WORKSPACE/output/dtb/." \
            AnyKernel3/dtb/ \
            || true

          if grep -q 'do.devicecheck=' AnyKernel3/anykernel.sh; then
            sed -i \
              's/^do.devicecheck=.*/do.devicecheck=0/' \
              AnyKernel3/anykernel.sh
          fi

      # ==========================================================
      # 18. PACKAGE ANYKERNEL3
      # ==========================================================
      - name: Package Flashable Kernel
        shell: bash
        run: |
          set -euxo pipefail

          cd "$GITHUB_WORKSPACE/AnyKernel3"

          rm -f \
            "$GITHUB_WORKSPACE/output/Galaxy-TabA9-ReSukiSU-Kernel.zip"

          zip -r9 \
            "$GITHUB_WORKSPACE/output/Galaxy-TabA9-ReSukiSU-Kernel.zip" \
            . \
            -x '.git/*' \
            -x '.github/*'

      # ==========================================================
      # 19. SHA256
      # ==========================================================
      - name: Generate SHA256
        shell: bash
        run: |
          set -euxo pipefail

          cd "$GITHUB_WORKSPACE/output"

          sha256sum \
            Image* \
            Galaxy-TabA9-ReSukiSU-Raw.zip \
            Galaxy-TabA9-ReSukiSU-Kernel.zip \
            > SHA256SUMS.txt

          cat SHA256SUMS.txt

      # ==========================================================
      # 20. UPLOAD
      # ==========================================================
      - name: Upload Kernel Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: Galaxy-TabA9-ReSukiSU-Kernel
          path: |
            ${{ github.workspace }}/output/**
          if-no-files-found: error
          retention-days: 14
```
